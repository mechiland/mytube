{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "skipLibCheck": true, "paths": {"@/*": ["./src/*"]}, "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "*.ts", "worker-configuration.d.ts"]
}
