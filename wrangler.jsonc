{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mytube",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/_serverFn/*", "/.env*", "/.dev.vars*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "mytube", "database_id": "00000000-0000-4000-8000-000000000001" }
  ],
  "ratelimits": [
    { "name": "REQUEST_LIMIT", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
    { "name": "LOOKUP_LIMIT", "namespace_id": "1002", "simple": { "limit": 18, "period": 60 } }
  ],
  "triggers": { "crons": ["* * * * *"] }
}
